# Feedstock recipe for fontist
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "fontist"
kind: app
summary: "Fontist — the font installer CLI (ruby app; runtime-required payload)"

upstream:
  # RubyGems closure, not a tarball: the dependency set is resolved from the
  # rubygems compact index and every .gem is sha256-verified against the
  # /info/<gem> checksum before use (tools/build).
  gem: "fontist"
  version: "3.0.10"
  source: "https://rubygems.org"

build:
  system: gemstage         # stage a GEM_HOME closure with a tebako runtime's own ruby
  runtime:
    engine: ruby
    version: "3.3.7"       # the staging + exec runtime (tebako-runtime-ruby)
    tebako: "0.16.3"       # runtime release line (image-era; the v0.1.5 CLI
                           # refuses pre-era releases by contract, exit 75)
  # The tebako CLI (>= v0.1.5) provisions the runtime SDK itself on POSIX
  # (headers + symbol stub for the exact runtime) — no feedstock-side SDK
  # on the mac leg. The windows leg builds brotli's extension against an
  # SDK assembled from this pinned tarball (tools/build; mkmf on mingw
  # also needs an import library, generated from the built static libruby
  # with dlltool — the runtime factory's own mechanism).
  sdk:
    url: "https://cache.ruby-lang.org/pub/ruby/3.3/ruby-3.3.7.tar.gz"
    sha256: "9c37c3b12288c7aec20ca121ce76845be5bb5d77662a24919651aaf1d12c8628"
  # Resolution overrides, each justified in docs/build-notes.md:
  pins:
    liquid: "5.6.0"        # >= 5.6.1 demands strscan >= 3.1.1 (source-only native)
  # Constraints the runtime's own default gems already satisfy — the payload
  # relies on the runtime for these (runtime-required kind: app):
  skip_defaults: [json, bigdecimal, strscan, racc, drb, uri, logger,
                  minitest, securerandom, benchmark, ostruct, rexml]

# Factory tools used by tools/build (image creation). The dwarfs-t
# mkdwarfs/tebakofs binaries ship as per-platform assets of libtfs
# releases; every download is verified against the release's SHA256SUMS.
# (mac leg images with mkdwarfs; the windows leg images with the tfs CLI
# from the tebako release — same Writer, in-process.)
tools:
  repo: "tamatebako/libtfs"
  release: "v0.13.0"

# Signing (spec 09 §9 — opt-in per feedstock): on tag pushes tools/publish
# signs every payload image (plus SHA256SUMS and the registry itself) with
# the CI signing subkey of the tamatebako root, supplied as the org secret
# TEBAKO_CI_SIGNING_KEY, and the registry pins the PRIMARY keyid (the
# identity, not the rotating subkey instrument). A declared signing block
# with an absent secret fails the publish — a signing feedstock never
# ships an unsigned release silently. The signer binary is fetched from
# the pinned release and verified against the pinned digest (the same
# trust-anchor role as upstream.sha256).
signing:
  keyid: "efc3c250f7862a48" # 2026-09-09 tamatebako root primary (low 64)
  tool:
    repo: "tamatebako/tebako"
    release: "v2.5.0"
    sha256: "071506449681529db8cca71a4b7aa6b65414434021649b7f18ef1ad55badf1bc" # tebako-pkg-2.5.0-linux-gnu-x86_64

platforms:
  - aarch64-macos          # triplet-bound (nokogiri/ffi precompiled, brotli
                           # compiled per-triplet). More triplets: CI legs.
  - x86_64-windows-ucrt    # built by CI (green incl. brotli); NOT published
                           # yet — the windows runtimes cannot load dynamic
                           # native extensions (docs/build-notes.md § Windows)

provides:
  entrypoints:
    - name: "fontist"
      path: "/bin/fontist"
      version: "3.0.10"
      runtime_requirement: {engine: ruby, constraint: "~> 3.3.0"}

annotations:
  gem: fontist
  gem_version: "3.0.10"
