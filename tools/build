#!/usr/bin/env bash
# tools/build — stage the fontist closure with a tebako runtime's own ruby
# and image it (one mechanical leg per triplet).
#
# Legs:
#   aarch64-macos (default) — shim staging: the stub press's deploy-driver
#     shim (o/p/ruby) runs every ruby process; the tebako CLI provisions
#     the runtime SDK itself, so brotli's source build rides the shim's
#     own build_overrides. Imaging: mkdwarfs-t (libtfs release asset).
#   x86_64-windows-ucrt (TRIPLET=) — driver staging: no ruby shim exists
#     on Windows (tebako-cli deploy.rs), so the staging scripts run as
#     entries of a purpose-built driver image (tfs mkimage) with the env
#     image handed over via TEBAKO_RUNTIME_IMAGE. brotli (source-only
#     gem) is built without rubygems' ExtConfBuilder subprocess
#     (tools/stage_brotli_manual.rb) against SDK headers from the pinned
#     ruby tarball + an import library derived from the runtime's ruby
#     DLL facet export table. Imaging: tfs mkimage.
#
# Inputs (env, all with sane defaults):
#   TRIPLET         aarch64-macos | x86_64-windows-ucrt
#   TEBAKO_CLI      tebako-cli binary (default: tebako on PATH)
#   TEBAKO_VERSION  runtime release line (default 0.16.25 — the feedstock
#                   pins the line; never ride the CLI's built-in default)
#   TEBAKO_HOME     runtime cache root (default: out/tebako-home)
#   MKDWARFS        mkdwarfs-t binary (mac leg; default: mkdwarfs on PATH)
#   TFS             tfs CLI binary (windows leg; default: tfs on PATH)
#   WORK            build workspace (default: out/work-$TRIPLET)
#   OUT             artifact dir   (default: out/$TRIPLET)
#
# Produces: $OUT/fontist-<version>-$TRIPLET.tfs (+ manifest yaml).
#
# Rules honored: no host ruby anywhere (the runtime IS the ruby); every
# download sha256-verified (.gem files against the compact index /info
# checksums, the ruby tarball against the recipe pin, the runtime against
# the tebako-runtime-ruby release manifest, verified by tebako-cli's
# resolver).
set -euo pipefail

FEEDSTOCK="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="3.0.10"
TRIPLET="${TRIPLET:-aarch64-macos}"
RUBY_V="3.3.12"
API_V="3.3.0"

TEBAKO_CLI="${TEBAKO_CLI:-tebako}"
TEBAKO_VERSION="${TEBAKO_VERSION:-0.16.25}"
MKDWARFS="${MKDWARFS:-mkdwarfs}"
TFS="${TFS:-tfs}"
WORK="${WORK:-$FEEDSTOCK/out/work-$TRIPLET}"
OUT="${OUT:-$FEEDSTOCK/out/$TRIPLET}"
export TEBAKO_HOME="${TEBAKO_HOME:-$FEEDSTOCK/out/tebako-home}"
CLOSURE="$FEEDSTOCK/closure/$VERSION-$TRIPLET.txt"

SDK_URL="https://cache.ruby-lang.org/pub/ruby/3.3/ruby-3.3.12.tar.gz"
SDK_SHA256="b06d63beae271933033e27f0a389bc582a009e7845357d44365c39de525a051b"

step() { printf '\n== %s\n' "$*"; }

sha256_file() { # portable sha256 (macOS: shasum; msys2/linux: sha256sum)
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

winpath() { # msys path → windows form for native exes / in-runtime ruby
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -m "$1"
  else
    echo "$1" | sed -E 's|^/([a-zA-Z])/|\U\1:/|'
  fi
}

[ -f "$CLOSURE" ] || { echo "no closure file for $TRIPLET: $CLOSURE"; exit 1; }
mkdir -p "$WORK" "$OUT" "$WORK/gempkgs"

# ---------------------------------------------------------------- runtime
step "resolve the tebako runtime $TEBAKO_VERSION"
case "$TRIPLET" in
  aarch64-macos)
    RT_PLATFORM="macos-arm64"
    # A stub press makes the CLI resolve the runtime (manifest-verified)
    # AND yields the deploy-driver shim (o/p/ruby) used for every ruby
    # invocation below. The Gemfile forces the bundler deploy ops (a
    # SimpleScript stub produces no driver); base64 is dep-free.
    # The entry file must not be named stub.rb: the app root mounts at
    # /local, so `stub.rb` collides with the press's reserved in-image
    # dispatcher path /local/stub.rb (tebako >= 2.1.1 rejects it,
    # exit 143). -R pins the ruby line — the 0.16.25 release hosts
    # several (3.1/3.2/3.3/3.4/4.0) and a pin-less press resolves the
    # newest, not the recipe's.
    mkdir -p "$WORK/stubapp"
    printf 'puts "stub"\n' > "$WORK/stubapp/main.rb"
    printf 'source "https://rubygems.org"\ngem "base64"\n' > "$WORK/stubapp/Gemfile"
    "$TEBAKO_CLI" press -r "$WORK/stubapp" -e main.rb -o "$WORK/stub-pkg" \
      -p "$WORK/prefix" -l warn --tebako-version "$TEBAKO_VERSION" \
      -R "$RUBY_V"
    SHIM="$WORK/prefix/o/p/ruby"
    [ -x "$SHIM" ] || { echo "no deploy shim at $SHIM"; exit 1; }
    ;;
  x86_64-windows-ucrt)
    RT_PLATFORM="windows-ucrt64"
    ;;
  *) echo "unknown TRIPLET: $TRIPLET"; exit 1 ;;
esac

RT_DIR="$TEBAKO_HOME/runtimes/ruby-$RUBY_V-$TEBAKO_VERSION-$RT_PLATFORM"
RT_EXE="$RT_DIR/tebako-runtime-$TEBAKO_VERSION-$RUBY_V-$RT_PLATFORM"
RT_IMAGE="$RT_DIR/tebako-runtime-$TEBAKO_VERSION-$RUBY_V-$RT_PLATFORM.tfs"

if [ "$TRIPLET" = "x86_64-windows-ucrt" ]; then
  # Direct fetch, verified against the release's per-asset .sha256
  # sidecars (the resolver's own trust anchors; tmp+rename, a partial
  # download never poisons the cache). The leg needs no shim (there is
  # none on Windows), so the direct fetch stays the simplest path.
  # 0.16.3+: the windows runtime is a stub exe + the ruby DLL facet —
  # the exe does not start without the facet next to it under the
  # shard manifest's dll.install_as name (the SSOT for the facet name).
  RT_RELEASE_URL="https://github.com/tamatebako/tebako-runtime-ruby/releases/download/v$TEBAKO_VERSION"
  RT_ASSET="tebako-runtime-$TEBAKO_VERSION-$RUBY_V-$RT_PLATFORM"
  mkdir -p "$RT_DIR"
  # The shard model: the per-stem <stem>.manifest.json is the SSOT for
  # the facet's install name; per-asset .sha256 sidecars are the trust
  # anchor. (The monolithic manifest.json / SHA256SUMS.txt stopped being
  # release assets on the 0.16.24 line.)
  curl -sL -o "$WORK/shard.json" "$RT_RELEASE_URL/$RT_ASSET.manifest.json"
  grep -q '"dll"' "$WORK/shard.json" \
    || { echo "no dll facet in shard $RT_ASSET.manifest.json (or the shard 404'd)"; exit 1; }
  # The facet's install name follows the factory's rubyinstaller-style
  # ABI rule (3.3.12 -> x64-ucrt-ruby330.dll) — derived, then asserted
  # against the shard's dll.install_as (the SSOT) so a convention change
  # fails loudly.
  DLL_INSTALL_AS="x64-ucrt-ruby$(echo "$RUBY_V" | awk -F. '{print $1 $2}')0.dll"
  SHARD_INSTALL_AS="$(sed -n 's/.*"install_as": *"\([^"]*\)".*/\1/p' "$WORK/shard.json")"
  [ -n "$SHARD_INSTALL_AS" ] || { echo "the shard carries no dll.install_as"; exit 1; }
  [ "$SHARD_INSTALL_AS" = "$DLL_INSTALL_AS" ] \
    || { echo "dll facet drift: shard install_as=$SHARD_INSTALL_AS, derived $DLL_INSTALL_AS"; exit 1; }
  for f in "$RT_ASSET" "$RT_ASSET.tfs" "$RT_ASSET.dll"; do
    dst="$f"; [ "$f" = "$RT_ASSET" ] && dst="$f.exe"   # resolver cache naming
    [ "$f" = "$RT_ASSET.dll" ] && dst="$DLL_INSTALL_AS"
    if [ ! -f "$RT_DIR/$dst" ]; then
      curl -sL -o "$RT_DIR/$dst.part" "$RT_RELEASE_URL/$f"
      curl -sL -o "$WORK/expected.sha" "$RT_RELEASE_URL/$f.sha256"
      want="$(cut -d' ' -f1 < "$WORK/expected.sha")"
      [ ${#want} -eq 64 ] || { rm -f "$RT_DIR/$dst.part"; echo "no .sha256 sidecar for $f"; exit 1; }
      got="$(sha256_file "$RT_DIR/$dst.part")"
      [ "$got" = "$want" ] || { rm -f "$RT_DIR/$dst.part"; echo "SHA256 MISMATCH $f"; exit 1; }
      mv "$RT_DIR/$dst.part" "$RT_DIR/$dst"
    fi
  done
  echo "runtime verified against tebako-runtime-ruby v$TEBAKO_VERSION shard sidecars (exe + image + $DLL_INSTALL_AS)"
  RT_EXE="$RT_EXE.exe"
fi
[ -f "$RT_EXE" ] || { echo "no cached runtime at $RT_EXE"; exit 1; }
[ -f "$RT_IMAGE" ] || { echo "no cached runtime image at $RT_IMAGE"; exit 1; }
# the boot smoke reads these (tools/boot_smoke's exec leg)
{ echo "RUNTIME=$(winpath "$RT_EXE")"
  echo "RUNTIME_IMAGE=$(winpath "$RT_IMAGE")"; } > "$OUT/runtime.env"

# ---------------------------------------------------------- fetch the gems
step "fetch + sha256-verify the closure ($CLOSURE)"
grep -v '^#' "$CLOSURE" | grep -v '^\s*$' | while read -r full sha; do
  f="$WORK/gempkgs/$full.gem"
  [ -f "$f" ] && continue
  curl -sL -o "$f" "https://rubygems.org/downloads/$full.gem"
  actual="$(sha256_file "$f")"
  [ "$actual" = "$sha" ] || { echo "SHA256 MISMATCH $full: $actual != $sha"; exit 1; }
done
echo "all gems verified"

# ------------------------------------------------------------------ stage
case "$TRIPLET" in
  aarch64-macos)
    step "stage the closure with the runtime ruby via the deploy shim"
    # The CLI's own RuntimeSdk (provisioned by the press) supplies the
    # header/link overrides inside shim runs; brotli builds its vendored
    # sources against them (PKG_CONFIG_LIBDIR masks any system libbrotli).
    export TEBAKO_PASS_THROUGH=1 SSL_CERT_FILE="${SSL_CERT_FILE:-/etc/ssl/cert.pem}"
    export GEM_HOME="$WORK/stage" GEM_PATH="$WORK/stage"
    export GEM_SPEC_CACHE="$WORK/stage/spec_cache"
    export CERT_DIR="$WORK/ssl_certs"
    export STAGE_DIR="$WORK/stage" GEMPKGS_DIR="$WORK/gempkgs"
    export PKG_CONFIG_LIBDIR=/nonexistent
    "$SHIM" "$FEEDSTOCK/tools/stage_app.rb" 2>&1 | grep -E "brotli|STAGE-OK|ERROR" \
      || true   # stage_app installs the whole dir; brotli just builds first
    unset PKG_CONFIG_LIBDIR
    find "$WORK/stage/extensions" -path "*brotli-0.8.0*" -name 'brotli.*' \
      | grep -q . || { echo "brotli native build failed"; exit 1; }
    ;;

  x86_64-windows-ucrt)
    # ----------------------- SDK: headers + import library (brotli link)
    step "mkmf SDK (ruby $RUBY_V for x64-mingw-ucrt, pinned + sha256-verified)"
    # Headers AND an import library (mkmf links on mingw). The import
    # lib's def is parsed from the facet DLL's OWN export table (the
    # facet is downloaded + sha256-verified in the runtime step above —
    # the SSOT for its export surface), named via --dllname so the
    # built extension imports the REAL ruby DLL facet ($DLL_INSTALL_AS —
    # derived + shard-asserted above, never pinned twice).
    #
    # The previous shape ran dlltool --export-all over a static libruby
    # built here from the tarball. That archive's globals include
    # symbols the real facet does NOT export (mkexports.rb PrivateNames:
    # Init_*, threadptr, DllMain) — every mingw extension's CRT startup
    # references DllMain, so the link bound it against the ruby DLL and
    # the extension's LoadLibrary would die ERROR_PROC_NOT_FOUND.
    # Deriving the def from the facet makes a runtime-missing import
    # impossible by construction and also retires the ruby compile
    # (configure stays: it generates config.h).
    SDK="$WORK/sdk"
    IMPLIB="$SDK/lib/libruby-exp.a"
    if [ ! -f "$IMPLIB" ]; then
      mkdir -p "$SDK/include/ruby-$API_V" "$SDK/lib"
      curl -sL -o "$WORK/ruby.tar.gz" "$SDK_URL"
      actual="$(sha256_file "$WORK/ruby.tar.gz")"
      [ "$actual" = "$SDK_SHA256" ] || { echo "SHA256 MISMATCH ruby tarball"; exit 1; }
      rm -rf "$WORK/ruby-src" "$WORK/ruby-build"
      mkdir -p "$WORK/ruby-src" "$WORK/ruby-build"
      tar xzf "$WORK/ruby.tar.gz" -C "$WORK/ruby-src" --strip-components=1
      (cd "$WORK/ruby-build" && "$WORK/ruby-src/configure" \
          --disable-shared --disable-install-doc \
          cppflags="-Wno-incompatible-pointer-types" > configure.log 2>&1)
      cp -R "$WORK/ruby-src/include/." "$SDK/include/ruby-$API_V/"
      mkdir -p "$SDK/include/ruby-$API_V/x64-mingw-ucrt/ruby"
      cp "$WORK/ruby-build"/.ext/include/*/ruby/config.h \
         "$SDK/include/ruby-$API_V/x64-mingw-ucrt/ruby/config.h"
      # objdump's [Ordinal/Name Pointer] table lists every exported name
      # (binutils is present — dlltool below is too); dot-leading
      # (.refptr.*) names must be quoted in def syntax.
      objdump -p "$RT_DIR/$DLL_INSTALL_AS" | awk '
        /^\[Ordinal\/Name Pointer\] Table/ { inexp = 1; next }
        inexp && /^[ \t]*\[[ \t]*[0-9]+\]/  { print "\"" $NF "\"" }
        inexp && /^[^ \t]/                  { inexp = 0 }' \
        > "$WORK/facet.exports"
      [ -s "$WORK/facet.exports" ] \
        || { echo "no exports parsed from $RT_DIR/$DLL_INSTALL_AS"; exit 1; }
      { echo EXPORTS; cat "$WORK/facet.exports"; } > "$SDK/lib/ruby.exp.def"
      dlltool --input-def="$SDK/lib/ruby.exp.def" --dllname "$DLL_INSTALL_AS" \
              --output-lib="$IMPLIB"
    fi
    sed -e "s|@@SDK_INCLUDE@@|$(winpath "$SDK/include/ruby-$API_V")|" \
        -e "s|@@IMPLIB@@|$(winpath "$IMPLIB")|" \
      "$FEEDSTOCK/tools/sdk_patch_msys.rb.in" > "$WORK/sdk_patch.rb"

    # ----------------------- staging driver image (the windows shim-less
    # ruby entry): the scripts ride a bare driver image mounted at /drv;
    # the env image comes in via TEBAKO_RUNTIME_IMAGE.
    step "staging driver image"
    DRIVER="$WORK/driver"
    rm -rf "$DRIVER"
    mkdir -p "$DRIVER"
    cp "$FEEDSTOCK/tools/stage_app.rb" "$FEEDSTOCK/tools/stage_brotli_manual.rb" "$DRIVER/"
    DRIVER_IMG="$WORK/stage-driver.tfs"
    rm -f "$DRIVER_IMG"
    "$TFS" mkimage --format dwarfs "$DRIVER" -o "$DRIVER_IMG"

    run_driver() { # <entry> [args...]
      # NB: MSYS2_ARG_CONV_EXCL='*' — MSYS2 path-converts POSIX-looking
      # argv ("/stage_app.rb" → "D:/.../msys64/stage_app.rb", even in
      # --flag=value form); the entry is a VFS path and must reach the
      # driver verbatim.
      local entry="$1"; shift
      MSYS2_ARG_CONV_EXCL='*' \
      TEBAKO_PASS_THROUGH=1 \
      TEBAKO_RUNTIME_IMAGE="$(winpath "$RT_IMAGE")" \
      GEM_HOME="$(winpath "$WORK/stage")" GEM_PATH="$(winpath "$WORK/stage")" \
      GEM_SPEC_CACHE="$(winpath "$WORK/stage/spec_cache")" \
      SSL_CERT_FILE="${SSL_CERT_FILE:-/etc/ssl/cert.pem}" \
      CERT_DIR="$(winpath "$WORK/ssl_certs")" \
      STAGE_DIR="$(winpath "$WORK/stage")" GEMPKGS_DIR="$(winpath "$WORK/gempkgs")" \
      BROTLI_GEM="$(winpath "$WORK/gempkgs/brotli-0.8.0.gem")" \
      BROTLI_BUILD="$(winpath "$WORK/brotli-build")" \
      "$RT_EXE" "--tebako-image=$(winpath "$DRIVER_IMG"):-:/drv" \
        "--tebako-entry=$entry" "$@"
    }

    step "stage the closure with the runtime ruby via the driver image"
    # rubygems' ExtConfBuilder cannot run on Windows (no shim, no memfs
    # spawn): precompiled gems install fine, brotli is skipped here and
    # built manually below.
    BROTLI_MANUAL=1 run_driver /stage_app.rb > "$WORK/stage.log" 2>&1 || true
    grep -q "STAGE-OK" "$WORK/stage.log" \
      || { echo "staging failed:"; tail -30 "$WORK/stage.log"; exit 1; }
    grep -E "STAGE-OK|installed" "$WORK/stage.log" | tail -3

    step "brotli native build (in-process extconf + host make)"
    # PKG_CONFIG_LIBDIR masks any system libbrotli so the gem builds its
    # vendored sources (self-contained payload), same as the mac leg.
    PKG_CONFIG_LIBDIR=/nonexistent \
    RUBYOPT="-r$(winpath "$WORK/sdk_patch.rb")" \
      run_driver /stage_brotli_manual.rb extconf
    (cd "$WORK/brotli-build/ext/brotli" && make -j"$(nproc 2>/dev/null || echo 4)")
    run_driver /stage_brotli_manual.rb place
    find "$WORK/stage/extensions" -path "*brotli-0.8.0*" -name 'brotli.so' \
      | grep -q . || { echo "brotli native build failed"; exit 1; }
    ;;
esac

# ----------------------------------------------------------- payload tree
step "assemble the payload tree"
PAYLOAD="$WORK/payload"
rm -rf "$PAYLOAD"
mkdir -p "$PAYLOAD/bin" "$PAYLOAD/lib/ruby/gems/$API_V" "$PAYLOAD/local"
G="$PAYLOAD/lib/ruby/gems/$API_V"
cp -R "$WORK/stage/gems" "$G/gems"
cp -R "$WORK/stage/specifications" "$G/specifications"
cp -R "$WORK/stage/extensions" "$G/extensions"
[ -d "$WORK/stage/build_info" ] && cp -R "$WORK/stage/build_info" "$G/build_info"
# drop stale byproducts of failed in-flight builds, if any
find "$G/gems" -maxdepth 1 -name "strscan-*" -exec rm -rf {} +
find "$G/extensions" -name "strscan-*" -exec rm -rf {} +
cp "$FEEDSTOCK/templates/bin/fontist" "$PAYLOAD/bin/fontist"
chmod 755 "$PAYLOAD/bin/fontist"
cp "$FEEDSTOCK/templates/local/stub.rb" "$PAYLOAD/local/stub.rb"

# ------------------------------------------------------------------ image
step "image the payload"
IMG="$OUT/fontist-$VERSION-$TRIPLET.tfs"
rm -f "$IMG"
case "$TRIPLET" in
  aarch64-macos)       "$MKDWARFS" -i "$PAYLOAD" -o "$IMG" --no-progress ;;
  x86_64-windows-ucrt) "$TFS" mkimage --format dwarfs "$PAYLOAD" -o "$IMG" ;;
esac
sha="$(sha256_file "$IMG")"
echo "image: $IMG"
echo "sha256: $sha"

# --------------------------------------------------------------- manifest
step "fill the manifest"
# Per-triplet name: both legs' manifests land on the SAME release as
# assets — a bare <name>-<version>.manifest.yaml collides at upload.
MAN="$OUT/fontist-$VERSION-$TRIPLET.manifest.yaml"
sed -e "s|blob_sha256: \"0*\"|blob_sha256: \"$sha\"|" \
    -e "s|created: \"[^\"]*\"|created: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"|" \
    -e "s|commit: \"0*\"|commit: \"${GITHUB_SHA:-$(git -C "$FEEDSTOCK" rev-parse HEAD)}\"|" \
    -e "s|platforms: \[.*\]|platforms: [$TRIPLET]|" \
    "$FEEDSTOCK/manifests/payload.yaml" > "$MAN"
echo "manifest: $MAN"

# -------------------------------------------------------------- read-back
# A broken payload fails THIS leg, never the publish step (the openjdk
# incident: an invalid-YAML manifest caught at publish, exit 65). This
# feedstock ships the manifest as the sibling yaml (no in-image
# embedding): it must parse as YAML, and every entrypoint it declares
# must exist in the image — re-read with the pinned tfs CLI (the windows
# leg's own imager; on the mac leg the same CLI line reads the
# factory-mkdwarfs image, as tools/boot_smoke already does).
# Path rules (windows leg): the native tfs takes the host image path in
# native form (winpath), while the VFS entrypoint paths (/bin/fontist)
# must reach it verbatim — msys2 argument conversion would rewrite them
# to host paths (MSYS2_ARG_CONV_EXCL, inert on POSIX).
step "read-back: shipped manifest parses, declared entrypoints present"
ENTRY_PATHS="$(ruby --disable-gems -ryaml -e '
  $stdout.binmode   # ucrt64 ruby text mode would emit \r\n (breaks read -r)
  m = YAML.load(STDIN.read)
  es = (m.dig("provides", "entrypoints") || []) + (m.dig("provides", "executables") || [])
  es.each { |e| puts e["path"] }' < "$MAN")" || {
  echo "read-back FAILED: $MAN is not valid YAML"; exit 1; }
while IFS= read -r p; do
  p="${p%$'\r'}"   # belt-and-braces with the binmode above
  [ -n "$p" ] || continue
  MSYS2_ARG_CONV_EXCL='*' "$TFS" stat "$(winpath "$IMG")" "$p" >/dev/null || {
    echo "read-back FAILED: declared entrypoint $p missing from $IMG"; exit 1; }
  echo "read-back: $p present"
done <<< "$ENTRY_PATHS"
